];

    const _htmlDecoder = document.createElement("textarea");
    function decodeHtmlText(raw) {
      if (!raw) return "";
      _htmlDecoder.innerHTML = String(raw).replace(/<[^>]*>/g, " ");
      return _htmlDecoder.value.replace(/\s+/g, " ").trim();
    }

    function formatLocationCaption(raw, maxLen = 84) {
      let clean = decodeHtmlText(raw)
        .replace(/^File:/i, "")
        .replace(/\.(jpe?g|png|webp)$/i, "")
        .replace(/_/g, " ")
        .replace(/\s*\(©[^)]*\)\s*/g, "")
        .replace(/\s*©.*$/g, "")
        .replace(/\s+/g, " ")
        .trim();
      if (clean.length > maxLen) {
        clean = clean.slice(0, maxLen - 1).trimEnd() + "…";
      }
      return clean;
    }

    function normalizeTokens(raw) {
      return String(raw || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/([a-z])([A-Z])/g, "$1 $2")
        .replace(/[^a-zA-Z]+/g, " ")
        .toLowerCase()
        .replace(/\bnatural bridges?\b/g, "natural arch")
        .trim();
    }

    const LANDSCAPE_WHITELIST_RE = /\b(national park|nature reserve|wilderness|mountain|mountains|mount|peak|peaks|summit|ridge|pass|alpine|alps|dolomites|rockies|himalaya|andes|lake|lakes|loch|lagoon|pond|river|stream|creek|delta|estuary|waterfall|falls|cascade|forest|woods|woodland|rainforest|jungle|taiga|pine|redwood|sequoia|grove|autumn|fall foliage|ocean|sea|coast|coastline|shore|beach|cove|bay|peninsula|cape|strait|cliff|cliffs|fjord|archipelago|island|atoll|coral reef|glacier|iceberg|ice sheet|tundra|arctic|antarctica|canyon|gorge|ravine|valley|meadow|prairie|steppe|savanna|highlands|moor|heath|plateau|mesa|butte|badlands|desert|dune|dunes|oasis|volcano|crater|caldera|geyser|hot spring|aurora|northern lights)\b/;
    const NON_LANDSCAPE_BLACKLIST_RE = /\b(city|cities|ville|stadt|ciudad|citta|town|bourg|dorf|pueblo|village|borgo|urban|urbain|skyline|downtown|metropolis|street|rue|strasse|calle|avenue|boulevard|alley|ruelle|town square|public square|plaza|piazza|building|buildings|batiment|gebaude|edificio|skyscraper|gratte ciel|clock tower|bell tower|watchtower|water tower|radio tower|observation tower|eiffel|turm|torre|bridge|pont|brucke|puente|ponte|viaduct|viaduc|aqueduct|aqueduc|castle|chateau|schloss|burg|castillo|castello|palace|palais|palast|palacio|palazzo|fort|fortress|forteresse|festung|citadel|citadelle|ruins|ruine|ruinen|ruinas|cathedral|cathedrale|catedral|church|eglise|kirche|iglesia|chiesa|chapel|chapelle|kapelle|capilla|abbey|abbaye|abtei|abadia|monastery|monastere|kloster|monasterio|temple|shrine|sanctuaire|mosque|mosquee|pagoda|pagode|stupa|minaret|basilica|basilique|museum|musee|library|bibliotheque|theater|theatre|opera|stadium|stade|arena|university|universite|campus|parliament|parlement|capitol|station|gare|bahnhof|estacion|railway|chemin de fer|train|tram|subway|metro|harbor|harbour|port|hafen|puerto|porto|marina|pier|jetee|dock|quai|wharf|lighthouse|phare|leuchtturm|faro|windmill|moulin|windmuhle|molino|farm|ferme|bauernhof|granja|vineyard|vignoble|weinberg|plantation|terrace|terrasse|rice field|riziere|orchard|verger|pasture|paturage|garden|jardin|garten|monument|statue|memorial|sculpture|cross|croix|cemetery|cimetiere|festival|carnival|market|marche|bazaar|lantern|lanterne|fireworks|artifice|architecture|interior|interieur|rooftop|toit|hotel|resort|house|houses|maison|haus|casa|cottage|cabin|cabane|chalet|hut|refuge|tent|tente|camp|camping|barn|grange|silo|wall|mur|muraille|remparts|fence|cloture|boardwalk|passerelle|sentier|trail|path|chemin|road|route|highway|autoroute|traffic|car|cars|voiture|auto|bus|truck|camion|bicycle|velo|motorcycle|boat|boats|bateau|boot|barco|ship|navire|schiff|yacht|ferry|canoe|kayak|sailboat|voilier|fishing|peche|airport|aeroport|airplane|avion|helicopter|factory|usine|dam|barrage|reservoir|canal|ecluse|mine|quarry|carriere|wind turbine|eolienne|pylon|pylone|antenna|antenne|observatory|observatoire|cave|caves|cavern|caverns|grotte|grottes|caverne|gouffre|aven|hohle|cueva|grotta|cenote|sinkhole|subterranean|underground|stalactite|stalagmite|speleothem|close up|closeup|macro|flower|fleur|blume|blossom|petal|petale|mushroom|champignon|fungus|insect|insecte|beetle|spider|araignee|butterfly|papillon|bird|oiseau|vogel|puffin|penguin|manchot|flamingo|flamant|owl|hibou|chouette|eagle|aigle|hawk|falcon|heron|swan|cygne|duck|canard|goose|seagull|animal|wildlife|faune|fox|renard|bear|ours|wolf|loup|deer|cerf|elk|moose|elan|reindeer|renne|caribou|bison|buffalo|horse|cheval|sheep|mouton|cow|vache|goat|chevre|ibex|bouquetin|chamois|marmot|marmotte|squirrel|ecureuil|rabbit|lapin|hare|lievre|frog|grenouille|turtle|tortue|lizard|snake|serpent|whale|baleine|dolphin|dauphin|seal|phoque|otter|loutre|fish|poisson|shark|requin|jellyfish|meduse|painting|peinture|gemalde|drawing|dessin|illustration|diagram|map|carte|karte|chart|logo|flag|drapeau|portrait|people|person|personne|homme|femme|enfant|tourist|touriste|hiker|randonneur|climber|alpiniste|skier|skieur|surfer|swimmer|crowd|foule|satellite|from space|astronaut|spacecraft|iss|orbit|orbital|nebula|galaxy|planet|moon|eclipse)\b/;
    const CATEGORY_BLACKLIST_RE = /\b(paintings|drawings|illustrations|diagrams|maps|architecture|buildings|cities|towns|villages|townscapes|cityscapes|cultural landscapes|bridges|castles|churches|temples|monuments|animals|birds|insects|flowers|mushrooms|spaceflight|satellites|people|humans|vehicles|watercraft|ships|boats|roads|railways|agriculture|farms|lighthouses|towers|ruins|structures|caves|caverns|subterranean|speleothems)\b/;

    const poolCache = { wikimedia: [], bingNature: [] };
    const usedWikimediaCats = new Set();
    const usedBingMarkets = new Set();

    function pickUnseenItem(list) {
      if (!list || !list.length) return null;
      const unseen = list.filter(item => !AppState.seenBgUrls.includes(item.url));
      const sourceList = unseen.length ? unseen : list;
      return sourceList[Math.floor(Math.random() * sourceList.length)];
    }

    function dedupePool(list) {
      const map = new Map();
      for (const item of list) {
        if (item && item.url && !map.has(item.url)) map.set(item.url, item);
      }
      return Array.from(map.values());
    }

    async function fetchWikimediaNatureItem() {
      const unseenCached = poolCache.wikimedia.filter(item => !AppState.seenBgUrls.includes(item.url));
      if (unseenCached.length >= 5) {
        return unseenCached[Math.floor(Math.random() * unseenCached.length)];
      }

      const availableCats = WIKIMEDIA_PURE_NATURE_CATEGORIES.filter(c => !usedWikimediaCats.has(c));
      const catPool = availableCats.length ? availableCats : WIKIMEDIA_PURE_NATURE_CATEGORIES;
      const cat = catPool[Math.floor(Math.random() * catPool.length)];
      usedWikimediaCats.add(cat);

      const apiUrl = `https://commons.wikimedia.org/w/api.php?action=query&generator=categorymembers&gcmtitle=${encodeURIComponent(cat)}&gcmtype=file&gcmlimit=500&prop=imageinfo&iiprop=url|size|extmetadata&iiurlwidth=2560&format=json&origin=*`;
      const res = await fetch(apiUrl);
      const data = await res.json();
      const pages = data && data.query && data.query.pages ? Object.values(data.query.pages) : [];
      const items = [];

      for (const p of pages) {
        const ii = p.imageinfo && p.imageinfo[0];
        if (!ii || !ii.width || !ii.height) continue;
        if (ii.width <= ii.height || ii.width < MIN_BG_WIDTH || ii.height < MIN_BG_HEIGHT) continue;

        let chosen = "";
        if (ii.thumburl && ii.thumbwidth >= MIN_BG_WIDTH && ii.thumbheight >= MIN_BG_HEIGHT) {
          chosen = ii.thumburl;
        } else if (ii.url && (!ii.size || ii.size <= 14 * 1024 * 1024)) {
          chosen = ii.url;
        }
        if (!chosen || !/\.(jpe?g|png|webp)(\?|$)/i.test(chosen)) continue;

        const meta = ii.extmetadata || {};
        const objectName = (meta.ObjectName && meta.ObjectName.value) || "";
        const imgDesc = (meta.ImageDescription && meta.ImageDescription.value) || "";
        const rawDesc = [p.title || "", objectName, imgDesc].join(" ").replace(/<[^>]*>/g, " ").slice(0, 600);
        const rawCats = ((meta.Categories && meta.Categories.value) || "").replace(/<[^>]*>/g, " ");

        if (NON_LANDSCAPE_BLACKLIST_RE.test(normalizeTokens(rawDesc))) continue;
        if (CATEGORY_BLACKLIST_RE.test(normalizeTokens(rawCats))) continue;

        items.push({ url: chosen, caption: formatLocationCaption(objectName || p.title || "") });
      }

      if (items.length) poolCache.wikimedia = dedupePool(poolCache.wikimedia.concat(items));
      return pickUnseenItem(poolCache.wikimedia);
    }

    async function fetchBingNatureArchiveItem() {
      const unseenCached = poolCache.bingNature.filter(item => !AppState.seenBgUrls.includes(item.url));
      if (unseenCached.length >= 5) {
        return unseenCached[Math.floor(Math.random() * unseenCached.length)];
      }

      const availableMarkets = BING_ARCHIVE_MARKETS.filter(m => !usedBingMarkets.has(m));
      const mktPool = availableMarkets.length ? availableMarkets : BING_ARCHIVE_MARKETS;
      const mkt = mktPool[Math.floor(Math.random() * mktPool.length)];
      usedBingMarkets.add(mkt);

      const res = await fetch(`https://bing.npanuhin.me/${mkt}.json`);
      const data = await res.json();
      if (Array.isArray(data)) {
        const items = [];
        for (const entry of data) {
          if (!entry || !entry.url) continue;
          const normTitle = normalizeTokens(`${entry.title || ""} ${entry.copyright || ""}`);
          const normAll = normalizeTokens(`${entry.title || ""} ${entry.copyright || ""} ${entry.url}`);
          if (NON_LANDSCAPE_BLACKLIST_RE.test(normAll)) continue;
          if (!LANDSCAPE_WHITELIST_RE.test(normTitle)) continue;

          items.push({ url: entry.url, caption: formatLocationCaption(entry.title || entry.copyright || "") });
        }
        if (items.length) poolCache.bingNature = dedupePool(poolCache.bingNature.concat(items));
      }
      return pickUnseenItem(poolCache.bingNature);
    }

    function pickLocalImage() {
      if (!LOCAL_IMAGES.length) return null;
      const recent = AppState.seenBgUrls.slice(-8);
      const unseen = LOCAL_IMAGES.filter(i => !recent.includes(i.url));
      const pool = unseen.length ? unseen : LOCAL_IMAGES;
      const item = pool[Math.floor(Math.random() * pool.length)];
      return { url: item.url, caption: item.caption || "", isLocal: true };
    }

    async function pickCachedRemoteBgItem() {
      if (!("caches" in window)) return null;
      try {
        const cache = await caches.open(REMOTE_BG_CACHE);
        const requests = await cache.keys();
        if (!requests.length) return null;
        const urls = requests.map(r => r.url);
        const recent = AppState.seenBgUrls.slice(-8);
        const unseen = urls.filter(u => !recent.includes(u));
        const pool = unseen.length ? unseen : urls;
        const chosenUrl = pool[Math.floor(Math.random() * pool.length)];
        const filePart = decodeURIComponent(chosenUrl.split("/").pop().split("?")[0] || "");
        return { url: chosenUrl, caption: formatLocationCaption(filePart), isCachedRemote: true };
      } catch (e) {
        return null;
      }
    }

    const CustomBgStore = (() => {
      const DB_NAME = "pomodoro-custom-bg-db";
      const STORE_NAME = "assets";
      const KEY = "break-image";
      let dbPromise = null;

      function openDb() {
        if (!("indexedDB" in window)) return Promise.resolve(null);
        if (dbPromise) return dbPromise;
        dbPromise = new Promise(resolve => {
          try {
            const req = indexedDB.open(DB_NAME, 1);
            req.onupgradeneeded = () => {
              const db = req.result;
              if (!db.objectStoreNames.contains(STORE_NAME)) {
                db.createObjectStore(STORE_NAME);
              }
            };
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => resolve(null);
          } catch (e) {
            resolve(null);
          }
        });
        return dbPromise;
      }

      async function save(file) {
        const db = await openDb();
        if (!db) return false;
        return new Promise(resolve => {
          try {
            const tx = db.transaction(STORE_NAME, "readwrite");
            tx.objectStore(STORE_NAME).put({
              blob: file,
              name: file.name || "Custom image",
              updatedAt: Date.now()
            }, KEY);
            tx.oncomplete = () => resolve(true);
            tx.onerror = () => resolve(false);
          } catch (e) {
            resolve(false);
          }
        });
      }

      async function load() {
        const db = await openDb();
        if (!db) return null;
        return new Promise(resolve => {
          try {
            const tx = db.transaction(STORE_NAME, "readonly");
            const req = tx.objectStore(STORE_NAME).get(KEY);
            req.onsuccess = () => resolve(req.result || null);
            req.onerror = () => resolve(null);
          } catch (e) {
            resolve(null);
          }
        });
      }

      async function clear() {
        const db = await openDb();
        if (!db) return;
        return new Promise(resolve => {
          try {
            const tx = db.transaction(STORE_NAME, "readwrite");
            tx.objectStore(STORE_NAME).delete(KEY);
            tx.oncomplete = () => resolve();
            tx.onerror = () => resolve();
          } catch (e) {
            resolve();
          }
        });
      }

      return { save, load, clear };
    })();

    let currentCustomObjectUrl = "";

    async function loadCustomBgItem() {
      const record = await CustomBgStore.load();
      if (!record || !record.blob) return null;
      const nextUrl = URL.createObjectURL(record.blob);
      if (currentCustomObjectUrl && currentCustomObjectUrl !== nextUrl) {
        const prevUrl = currentCustomObjectUrl;
        setTimeout(() => URL.revokeObjectURL(prevUrl), 2500);
      }
      currentCustomObjectUrl = nextUrl;
      return {
        url: nextUrl,
        caption: formatLocationCaption(record.name || "Custom image"),
        isLocal: true
      };
    }

    async function saveCustomBgFile(file) {
      if (!file) return false;
      return await CustomBgStore.save(file);
    }

    async function getCustomBgMeta() {
      const record = await CustomBgStore.load();
      if (!record || !record.blob) return null;
      return { name: record.name || "Custom image" };
    }

    async function clearCustomBg() {
      await CustomBgStore.clear();
      if (currentCustomObjectUrl) {
        URL.revokeObjectURL(currentCustomObjectUrl);
        currentCustomObjectUrl = "";
      }
    }

    async function resolveNextBgItem(source) {
      if (source === "custom") {
        const customItem = await loadCustomBgItem();
        return customItem || pickLocalImage();
      }
      if (!navigator.onLine) {
        if (source !== "local") {
          const cachedRemote = await pickCachedRemoteBgItem();
          if (cachedRemote) return cachedRemote;
        }
        return pickLocalImage();
      }
      if (source === "local") return pickLocalImage();
      if (source === "auto") {
        try {
          const item = await fetchWikimediaNatureItem();
          if (item) return item;
        } catch (e) {}
        return (await pickCachedRemoteBgItem()) || pickLocalImage();
      }

      const chosenSource = source === "mix"
        ? (Math.random() < 0.65 ? "wikimedia" : "bing-nature")
        : source;

      try {
        if (chosenSource === "wikimedia") {
          const item = await fetchWikimediaNatureItem();
          if (item) return item;
        } else if (chosenSource === "bing-nature") {
          const item = await fetchBingNatureArchiveItem();
          if (item) return item;
        }
      } catch (e) {}

      try {
        const fallback = chosenSource === "wikimedia"
          ? await fetchBingNatureArchiveItem()
          : await fetchWikimediaNatureItem();
        if (fallback) return fallback;
      } catch (e) {}

      return await pickCachedRemoteBgItem();
    }

    const _lumCanvas = document.createElement("canvas");
    _lumCanvas.width = 32;
    _lumCanvas.height = 32;
    const _lumCtx = _lumCanvas.getContext("2d", { willReadFrequently: true });

    function computeAdaptiveContrast(imgEl) {
      try {
        if (!_lumCtx) return { veilOpacity: 0.18, textSlope: 1.18 };
        _lumCtx.drawImage(imgEl, 0, 0, 32, 32);
        const data = _lumCtx.getImageData(0, 0, 32, 32).data;
        let totalLum = 0;
        const pixels = data.length / 4;
        for (let i = 0; i < data.length; i += 4) {
          totalLum += (0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2]) / 255;
        }
        const lum = Math.max(0, Math.min(1, totalLum / pixels));
        return {
          veilOpacity: Number((0.08 + lum * 0.24).toFixed(3)),
          textSlope: Number((1.24 - lum * 0.12).toFixed(3))
        };
      } catch (e) {
        return { veilOpacity: 0.18, textSlope: 1.18 };
      }
    }

    const _blurCanvas = document.createElement("canvas");
    _blurCanvas.width = 480;
    _blurCanvas.height = 270;
    const _blurCtx = _blurCanvas.getContext("2d");

    function bakeBlurredBreakImage(imgEl, textSlope) {
      try {
        if (!_blurCtx) return "";
        const w = _blurCanvas.width;
        const h = _blurCanvas.height;
        _blurCtx.save();
        _blurCtx.clearRect(0, 0, w, h);
        _blurCtx.filter = `blur(10px) brightness(${(textSlope * 100).toFixed(1)}%)`;
        _blurCtx.drawImage(imgEl, -16, -16, w + 32, h + 32);
        _blurCtx.restore();
        return _blurCanvas.toDataURL("image/jpeg", 0.82);
      } catch (e) {
        return "";
      }
    }

    let activeBg = null;
    let preloadedBg = null;
    let isFetchingBg = false;
    let isPreloadingBg = false;
    let activeReqId = 0;
    let preloadReqId = 0;
    let revealRaf = null;
    let clearCleanupTimer = null;
    let isVisuallyRevealed = false;

    function decodeUrl(url) {
      if (!url) return Promise.resolve();
      return new Promise(resolve => {
        const probe = new Image();
        probe.decoding = "async";
        probe.onload = () => {
          if (probe.decode) probe.decode().then(resolve, resolve);
          else resolve();
        };
        probe.onerror = resolve;
        probe.src = url;
      });
    }

    function syncGeometry() {
      if (!activeBg || !DOM.el.classList.contains("break-image-ready")) return;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (!vw || !vh) return;
      const ratio = activeBg.aspectRatio || (16 / 9);
      let coverW = vw;
      let coverH = vw / ratio;
      if (coverH < vh) {
        coverH = vh;
        coverW = vh * ratio;
      }
      DOM.el.style.backgroundSize = `${coverW.toFixed(1)}px ${coverH.toFixed(1)}px`;
    }

    function applyReadyBackground(bgObj) {
      clearTimeout(clearCleanupTimer);
      clearCleanupTimer = null;
      cancelAnimationFrame(revealRaf);
      revealRaf = null;
      isVisuallyRevealed = false;

      DOM.bgLayer.classList.remove("active");
      if (DOM.bgVeil) DOM.bgVeil.style.opacity = "0";
      DOM.el.classList.remove("break-image-revealed");

      activeBg = bgObj;
      DOM.bgLayer.style.backgroundImage = `url("${bgObj.url}")`;
      DOM.el.style.backgroundImage = `url("${bgObj.blurredUrl || bgObj.url}")`;
      DOM.el.classList.add("break-image-ready");
      syncGeometry();
    }

    function syncVisualReveal(show) {
      const shouldShow = Boolean(show && activeBg && activeBg.url);
      if (shouldShow === isVisuallyRevealed) return;
      isVisuallyRevealed = shouldShow;
      cancelAnimationFrame(revealRaf);
      revealRaf = null;

      if (shouldShow) {
        clearTimeout(clearCleanupTimer);
        clearCleanupTimer = null;
        DOM.el.classList.add("break-image-ready");
        syncGeometry();
        // Force le rendu initial (opacity: 0 + texte blanc) avant le fondu simultané
        void DOM.bgLayer.offsetWidth;
        void DOM.el.offsetWidth;
        revealRaf = requestAnimationFrame(() => {
          revealRaf = null;
          if (!isVisuallyRevealed || !activeBg) return;
          DOM.bgLayer.classList.add("active");
          if (DOM.bgVeil) DOM.bgVeil.style.opacity = String(activeBg.veilOpacity);
          DOM.el.classList.add("break-image-revealed");
        });
      } else {
        DOM.bgLayer.classList.remove("active");
        if (DOM.bgVeil) DOM.bgVeil.style.opacity = "0";
        DOM.el.classList.remove("break-image-revealed");
      }
    }

    function clearPreload() {
      preloadReqId++;
      isPreloadingBg = false;
      preloadedBg = null;
    }

    function clear(keepPreload = false) {
      activeReqId++;
      isFetchingBg = false;
      activeBg = null;
      if (!keepPreload) clearPreload();
      DOM.bgCaptionEl.classList.remove("visible");

      const hadVisual = isVisuallyRevealed || DOM.el.classList.contains("break-image-ready");
      syncVisualReveal(false);

      clearTimeout(clearCleanupTimer);
      if (hadVisual && !prefersReducedMotion()) {
        clearCleanupTimer = setTimeout(() => {
          clearCleanupTimer = null;
          if (!activeBg) {
            DOM.el.classList.remove("break-image-ready");
            DOM.el.style.backgroundImage = "";
            DOM.el.style.backgroundSize = "";
            DOM.bgLayer.style.backgroundImage = "";
          }
        }, 1000);
      } else {
        clearCleanupTimer = null;
        DOM.el.classList.remove("break-image-ready");
        DOM.el.style.backgroundImage = "";
        DOM.el.style.backgroundSize = "";
        DOM.bgLayer.style.backgroundImage = "";
      }
    }

    function fetchValidBreakImage(source, isCancelled, attempt = 0) {
      if (isCancelled() || attempt > 8) return Promise.resolve(null);

      return resolveNextBgItem(source).then(item => {
        if (isCancelled() || !item || !item.url) return null;
        const { url, caption, isLocal } = item;

        return new Promise(resolve => {
          const img = new Image();
          img.crossOrigin = "anonymous";
          img.decoding = "async";

          img.onload = async () => {
            if (img.decode) { try { await img.decode(); } catch (e) {} }
            if (isCancelled()) { resolve(null); return; }
            StorageManager.markBgSeen(url);

            if (!isLocal && (img.naturalWidth < MIN_BG_WIDTH || img.naturalHeight < MIN_BG_HEIGHT)) {
              resolve(fetchValidBreakImage(source, isCancelled, attempt + 1));
              return;
            }

            const contrast = computeAdaptiveContrast(img);
            const blurredUrl = bakeBlurredBreakImage(img, contrast.textSlope) || img.currentSrc || url;
            await decodeUrl(blurredUrl);
            if (isCancelled()) { resolve(null); return; }

            const aspectRatio = (img.naturalWidth && img.naturalHeight)
              ? (img.naturalWidth / img.naturalHeight)
              : (16 / 9);

            resolve({
              url,
              blurredUrl,
              caption: caption || "",
              veilOpacity: contrast.veilOpacity,
              textSlope: contrast.textSlope,
              aspectRatio
            });
          };

          img.onerror = () => {
            if (isCancelled()) { resolve(null); return; }
            StorageManager.markBgSeen(url);
            resolve(fetchValidBreakImage(source, isCancelled, attempt + 1));
          };

          img.src = url;
        });
      });
    }

    function startPreload(source) {
      isPreloadingBg = true;
      const reqId = ++preloadReqId;
      fetchValidBreakImage(source, () => reqId !== preloadReqId).then(res => {
        if (reqId !== preloadReqId) return;
        isPreloadingBg = false;
        if (!res) return;

        if (AppState.isBreak() && isSwitchActive(DOM.bgToggle) && !activeBg) {
          applyReadyBackground(res);
          update();
        } else {
          preloadedBg = res;
        }
      });
    }

    function ensurePreloaded() {
      if (!isSwitchActive(DOM.bgToggle)) return;
      if (preloadedBg || isPreloadingBg) return;
      if (AppState.isBreak() && (activeBg || isFetchingBg)) return;
      const source = DOM.bgSourceSelect ? DOM.bgSourceSelect.value : "auto";
      startPreload(source);
    }

    function startLoad(source) {
      isFetchingBg = true;
      const reqId = ++activeReqId;
      fetchValidBreakImage(source, () => reqId !== activeReqId).then(res => {
        if (reqId !== activeReqId) return;
        isFetchingBg = false;
        if (!res) return;

        applyReadyBackground(res);
        update();
      });
    }

    function promotePreloadedIfAvailable() {
      if (preloadedBg && preloadedBg.url) {
        const ready = preloadedBg;
        preloadedBg = null;
        isPreloadingBg = false;
        applyReadyBackground(ready);
        return true;
      }
      return false;
    }

    function syncCaptionVisibility() {
      const show = DOM.popup.classList.contains("visible")
        && AppState.running
        && AppState.isBreak()
        && isSwitchActive(DOM.bgToggle)
        && Boolean(activeBg && activeBg.url && activeBg.caption);

      if (show) DOM.bgCaptionEl.textContent = activeBg.caption;
      DOM.bgCaptionEl.classList.toggle("visible", show);
    }

    function update() {
      const bgEnabled = isSwitchActive(DOM.bgToggle);
      if (!bgEnabled) {
        if (activeBg || isFetchingBg || preloadedBg || isPreloadingBg) clear(false);
        return;
      }

      if (AppState.isFocus()) {
        if (activeBg || isFetchingBg) clear(true);
        ensurePreloaded();
        return;
      }

      if (!activeBg && !isFetchingBg && !isPreloadingBg) {
        const source = DOM.bgSourceSelect ? DOM.bgSourceSelect.value : "auto";
        startLoad(source);
      }

      const show = AppState.running && Boolean(activeBg && activeBg.url);
      syncVisualReveal(show);
      syncCaptionVisibility();
    }

    function hotSwapSource() {
      clearPreload();
      const isBreakActive = AppState.isBreak() && isSwitchActive(DOM.bgToggle) && AppState.running;
      if (!isBreakActive || !activeBg) {
        clear(false);
        ensurePreloaded();
        return false;
      }
      const source = DOM.bgSourceSelect ? DOM.bgSourceSelect.value : "auto";
      startLoad(source);
      return true;
    }

    function resetPools() {
      poolCache.wikimedia = [];
      poolCache.bingNature = [];
      usedWikimediaCats.clear();
      usedBingMarkets.clear();
    }

    return {
      clear,
      update,
      syncGeometry,
      promotePreloadedIfAvailable,
      syncCaptionVisibility,
      hotSwapSource,
      resetPools,
      saveCustomBgFile,
      getCustomBgMeta,
      clearCustomBg
    };
  })();

  /* =========================================================================
   * 5. MOTEUR TYPOGRAPHIQUE (TypographyEngine)
   * ========================================================================= */
  const TypographyEngine = (() => {
    const WDTH_MIN = 25;
    const WDTH_MAX = 151;
    const WGHT_RUNNING = 300;
    const WGHT_PAUSED  = 100;
    const ROND_RUNNING = 0;
    const ROND_PAUSED  = 100;
    const EASE_IN_OUT = t => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const mc = document.createElement("canvas").getContext("2d");
    const fitCache = new Map();
    let measureEl = null;
    let recheckFontRaf = null;

    let inkHRatio     = 0.72;
    let inkShiftRatio = 0.035;

    let currentWdth   = 100;
    let currentWght   = WGHT_PAUSED;
    let currentRond   = ROND_PAUSED;
    let currentFs     = 100;
    let currentShift  = 0;
    let isFitted      = false;
    let stateAnimRaf  = null;

    function getViewportSize() {
      const bodyRect = document.body ? document.body.getBoundingClientRect() : null;
      const vw = Math.min(
        (bodyRect && bodyRect.width) || Infinity,
        document.documentElement.clientWidth || Infinity,
        (window.visualViewport && window.visualViewport.width) || Infinity,
        window.innerWidth || Infinity
      );
      const vh = Math.min(
        (bodyRect && bodyRect.height) || Infinity,
        document.documentElement.clientHeight || Infinity,
        (window.visualViewport && window.visualViewport.height) || Infinity,
        window.innerHeight || Infinity
      );
      return {
        vw: Number.isFinite(vw) ? vw : 0,
        vh: Number.isFinite(vh) ? vh : 0
      };
    }

    function getMeasureEl() {
      if (measureEl && measureEl.isConnected) return measureEl;
      measureEl = document.createElement("span");
      measureEl.setAttribute("aria-hidden", "true");
      measureEl.style.cssText = [
        "position:fixed",
        "left:-9999px",
        "top:-9999px",
        "visibility:hidden",
        "pointer-events:none",
        "white-space:nowrap",
        "line-height:1",
        'font-family:"Google Sans Flex", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif',
        "font-weight:100",
        "font-variant-numeric:tabular-nums",
        'font-feature-settings:"tnum" 1',
        "letter-spacing:-0.03em"
      ].join(";");
      document.body.appendChild(measureEl);
      return measureEl;
    }

    function updateInkMetrics(wght) {
      try {
        if (!mc) return;
        mc.font = `${wght} 1000px "Google Sans Flex", -apple-system, sans-serif`;
        mc.fontStretch = "normal";
        const m = mc.measureText("00:00");
        const inkA  = (m.actualBoundingBoxAscent  || 720) / 1000;
        const inkD  = (m.actualBoundingBoxDescent || 0)   / 1000;
        const fontA = (m.fontBoundingBoxAscent    || 850) / 1000;
        const fontD = (m.fontBoundingBoxDescent   || 200) / 1000;
        if (inkA + inkD > 0.3) {
          inkHRatio     = inkA + inkD;
          inkShiftRatio = (inkA - inkD - fontA + fontD) / 2;
        }
      } catch (e) {}
    }

    function computeFitForState(targetWght, targetRond) {
      const { vw, vh } = getViewportSize();
      if (!vw || !vh) return null;

      const text = DOM.el.textContent || "25:00";
      const cacheKey = `${Math.round(vw)}x${Math.round(vh)}|${text.length}|${targetWght}|${targetRond}`;
      const cached = fitCache.get(cacheKey);
      if (cached) return cached;

      const margin = Math.min(vw, vh) * 0.04;
      const maxW = Math.max(0, vw - 2 * margin);
      const maxH = Math.max(0, vh - 2 * margin);
      if (!maxW || !maxH) return null;

      updateInkMetrics(targetWght);

      const mEl = getMeasureEl();
      mEl.textContent = text;
      mEl.style.fontSize = "250px";

      mEl.style.fontVariationSettings = `"wght" ${targetWght}, "wdth" ${WDTH_MIN}, "opsz" 144, "ROND" ${targetRond}`;
      const wMin = mEl.getBoundingClientRect().width * 4;
      mEl.style.fontVariationSettings = `"wght" ${targetWght}, "wdth" ${WDTH_MAX}, "opsz" 144, "ROND" ${targetRond}`;
      const wMax = mEl.getBoundingClientRect().width * 4;

      if (!wMin || !wMax || wMax <= wMin * 1.15) {
        const refW = Math.max(wMin || 0, wMax || 0, 2850);
        const fs = Math.min((maxW * 1000) / refW, (maxH * 1000) / (1000 * inkHRatio));
        if (!recheckFontRaf) {
          recheckFontRaf = requestAnimationFrame(() => {
            recheckFontRaf = null;
            if (isFitted) fit(true);
          });
        }
        return { wdth: 100, fs, shift: inkShiftRatio * fs, maxW };
      }

      let bestW = WDTH_MIN;
      let bestFs = 0;
      let bestInkW = wMin;
      let bestDiff = Infinity;
      let lo = WDTH_MIN;
      let hi = WDTH_MAX;

      for (let i = 0; i < 16; i++) {
        const mid = (lo + hi) / 2;
        mEl.style.fontVariationSettings = `"wght" ${targetWght}, "wdth" ${mid.toFixed(2)}, "opsz" 144, "ROND" ${targetRond}`;
        const boxW = mEl.getBoundingClientRect().width * 4;
        if (!boxW) { lo = mid; continue; }

        const inkW = boxW;
        const inkH = 1000 * inkHRatio;
        const fsW = (maxW * 1000) / inkW;
        const fsH = (maxH * 1000) / inkH;
        const fs  = Math.min(fsW, fsH);

        const textW = (inkW * fs) / 1000;
        const textH = (inkH * fs) / 1000;
        const diffX = vw - textW;
        const diffY = vh - textH;

        if (Math.abs(diffX - diffY) < bestDiff) {
          bestDiff = Math.abs(diffX - diffY);
          bestW = mid;
          bestFs = fs;
          bestInkW = inkW;
        }
        if (diffX > diffY) lo = mid;
        else               hi = mid;
      }

      if (!bestFs) return null;
      bestFs = Math.min(bestFs, (maxW * 1000) / bestInkW);
      mEl.style.fontSize = bestFs.toFixed(2) + "px";
      mEl.style.fontVariationSettings = `"wght" ${targetWght}, "wdth" ${bestW.toFixed(2)}, "opsz" 144, "ROND" ${targetRond}`;
      const actualW = mEl.getBoundingClientRect().width;
      if (actualW > maxW && actualW > 0) {
        bestFs *= (maxW / actualW) * 0.995;
      }

      const result = {
        wdth: bestW,
        fs: bestFs,
        shift: inkShiftRatio * bestFs,
        maxW
      };
      if (fitCache.size > 32) fitCache.clear();
      fitCache.set(cacheKey, result);
      return result;
    }

    function applyVariation() {
      DOM.el.style.fontVariationSettings =
        `"wght" ${currentWght.toFixed(1)}, "wdth" ${currentWdth.toFixed(2)}, "opsz" 144, "ROND" ${currentRond.toFixed(1)}`;
    }

    function clampRenderedBounds(maxW) {
      if (!maxW || !DOM.el) return;
      const rect = DOM.el.getBoundingClientRect();
      if (rect.width > maxW && rect.width > 0) {
        const ratio = (maxW / rect.width) * 0.985;
        currentFs *= ratio;
        currentShift = inkShiftRatio * currentFs;
        DOM.el.style.fontSize = currentFs.toFixed(2) + "px";
        DOM.el.style.transform = `translateY(${currentShift.toFixed(2)}px)`;
      }
    }

    function cancelAnimation() {
      if (stateAnimRaf !== null) {
        cancelAnimationFrame(stateAnimRaf);
        stateAnimRaf = null;
      }
    }

    function fit(clearCache = false) {
      if (clearCache) fitCache.clear();
      cancelAnimation();

      const targetWght = AppState.running ? WGHT_RUNNING : WGHT_PAUSED;
      const targetRond = AppState.running ? ROND_RUNNING : ROND_PAUSED;
      const res = computeFitForState(targetWght, targetRond);
      if (!res) return false;

      currentWght  = targetWght;
      currentRond  = targetRond;
      currentWdth  = res.wdth;
      currentFs    = res.fs;
      currentShift = res.shift;

      DOM.el.style.fontSize   = currentFs.toFixed(2) + "px";
      DOM.el.style.lineHeight = "1";
      DOM.el.style.transform  = `translateY(${currentShift.toFixed(2)}px)`;
      applyVariation();
      clampRenderedBounds(res.maxW);
      BreakBackgroundManager.syncGeometry();
      isFitted = true;
      return true;
    }

    function transitionToRunningState(isRunning) {
      if (!isFitted || prefersReducedMotion()) {
        fit();
        return;
      }
      const targetWght = isRunning ? WGHT_RUNNING : WGHT_PAUSED;
      const targetRond = isRunning ? ROND_RUNNING : ROND_PAUSED;
      if (currentWght === targetWght && currentRond === targetRond && stateAnimRaf === null) return;

      cancelAnimation();

      const startWght  = currentWght;
      const startRond  = currentRond;
      const startWdth  = currentWdth;
      const startFs    = currentFs;
      const startShift = currentShift;

      const targetFit = computeFitForState(targetWght, targetRond);
      if (!targetFit) return;

      const endWdth  = targetFit.wdth;
      const endFs    = targetFit.fs;
      const endShift = targetFit.shift;

      const animMs = 620;
      const startTime = performance.now();

      function step(now) {
        const t = Math.min(1, (now - startTime) / animMs);
        const eased = EASE_IN_OUT(t);

        currentWght  = startWght  + (targetWght - startWght)  * eased;
        currentRond  = startRond  + (targetRond - startRond)  * eased;
        currentWdth  = startWdth  + (endWdth    - startWdth)  * eased;
        currentFs    = startFs    + (endFs      - startFs)    * eased;
        currentShift = startShift + (endShift   - startShift) * eased;

        DOM.el.style.fontSize  = currentFs.toFixed(2) + "px";
        DOM.el.style.transform = `translateY(${currentShift.toFixed(2)}px)`;
        applyVariation();

        if (t >= 1) {
          stateAnimRaf = null;
          currentWght  = targetWght;
          currentRond  = targetRond;
          currentWdth  = endWdth;
          currentFs    = endFs;
          currentShift = endShift;
          DOM.el.style.fontSize  = endFs.toFixed(2) + "px";
          DOM.el.style.transform = `translateY(${endShift.toFixed(2)}px)`;
          applyVariation();
          clampRenderedBounds(targetFit.maxW);
          BreakBackgroundManager.syncGeometry();
          return;
        }

        stateAnimRaf = requestAnimationFrame(step);
      }
      stateAnimRaf = requestAnimationFrame(step);
    }

    function clearCacheAndRefit() {
      fitCache.clear();
      if (isFitted) fit();
    }

    return {
      getMeasureEl,
      fit,
      transitionToRunningState,
      applyVariation,
      clearCacheAndRefit,
      isReady: () => isFitted
    };
  })();

  /* =========================================================================
   * 6. CONTRÔLEUR DU MINUTEUR, FAVICON, MEDIA SESSION & WAKE LOCK
   * ========================================================================= */
  const TimerController = (() => {
    let lastRunning = null;
    let lastRenderedLength = null;
    let lastRenderedTimeText = null;
    let lastRenderedTimerIndex = null;

    const faviconCanvas = document.createElement("canvas");
    faviconCanvas.width = 64;
    faviconCanvas.height = 64;
    const faviconCtx = faviconCanvas.getContext("2d");
    let faviconLink = document.getElementById("dynamic-favicon") || document.querySelector('link[rel~="icon"]');
  document.querySelectorAll('link[rel~="icon"]').forEach((node) => {
    if (node !== faviconLink) node.remove();
  });
  if (!faviconLink) {
    faviconLink = document.createElement("link");
    faviconLink.id = "dynamic-favicon";
    faviconLink.rel = "icon";
    faviconLink.type = "image/png";
    document.head.appendChild(faviconLink);
  }
  let lastFaviconKey = "";
  const darkModeQuery = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;

  function isDarkTheme() {
    return !darkModeQuery || darkModeQuery.matches;
  }

  function commitFaviconCanvas() {
    const dataUrl = faviconCanvas.toDataURL("image/png");
    const nextLink = document.createElement("link");
    nextLink.id = "dynamic-favicon";
    nextLink.rel = "icon";
    nextLink.type = "image/png";
    nextLink.href = dataUrl;
    if (faviconLink && faviconLink.parentNode) {
      faviconLink.parentNode.replaceChild(nextLink, faviconLink);
    } else {
      document.head.appendChild(nextLink);
    }
    faviconLink = nextLink;
  }

  function drawStatusDot(color) {
    faviconCtx.clearRect(0, 0, 64, 64);
    faviconCtx.beginPath();
    faviconCtx.arc(32, 32, 28, 0, Math.PI * 2);
    faviconCtx.fillStyle = color;
    faviconCtx.fill();
    commitFaviconCanvas();
  }

  function updateFavicon(progressPct) {
    if (!faviconCtx) return;
    const dark = isDarkTheme();
    // Avant le démarrage de l'étape en cours : point d'état
    if (!AppState.running && !AppState.stageStarted) {
      if (AppState.isBreak()) {
        // Début d'une pause (= focus terminé) -> vert
        if (lastFaviconKey === "idle-break") return;
        lastFaviconKey = "idle-break";
        drawStatusDot("#30d158");
        return;
      }
      if (AppState.idx > 0 || AppState.afterBreak) {
        // Début d'un focus après une pause (hors démarrage initial) -> jaune
        if (lastFaviconKey === "idle-focus-next") return;
        lastFaviconKey = "idle-focus-next";
        drawStatusDot("#ffd60a");
        return;
      }
      // Démarrage initial / après Reset -> rouge
      if (lastFaviconKey === "idle-initial") return;
      lastFaviconKey = "idle-initial";
      drawStatusDot("#ff453a");
      return;
    }

    // 3. Session en cours ou en pause -> camembert de progression
    const ratio = Math.max(0, Math.min(1, progressPct / 100));
    const step = Math.round(ratio * 120);
    const key = `${step}-${AppState.running ? 1 : 0}-${dark ? 1 : 0}`;
    if (key === lastFaviconKey) return;
    lastFaviconKey = key;

    const cx = 32;
    const cy = 32;
    const r = 30;
    const activeColor = dark ? "#ffffff" : "#1c1c1e";
    const pausedColor = dark ? "rgba(255, 255, 255, 0.78)" : "rgba(28, 28, 30, 0.72)";
    const drawRatio = Math.max(0.015, ratio);

    faviconCtx.clearRect(0, 0, 64, 64);
    faviconCtx.beginPath();
    if (drawRatio < 0.999) faviconCtx.moveTo(cx, cy);
    faviconCtx.arc(cx, cy, r, -Math.PI / 2, -Math.PI / 2 + drawRatio * Math.PI * 2);
    if (drawRatio < 0.999) faviconCtx.closePath();
    faviconCtx.fillStyle = AppState.running ? activeColor : pausedColor;
    faviconCtx.fill();
    commitFaviconCanvas();
  }

    if (darkModeQuery) {
      const onThemeChange = () => {
        lastFaviconKey = "";
        const total = AppState.sequence[AppState.idx] || 1;
        const progress = AppState.overtime ? 100 : Math.min(100, Math.max(0, (1 - AppState.remaining / total) * 100));
        updateFavicon(progress);
      };
      if (darkModeQuery.addEventListener) darkModeQuery.addEventListener("change", onThemeChange);
      else if (darkModeQuery.addListener) darkModeQuery.addListener(onThemeChange);
    }

    let lastMediaMetaKey = "";
    let lastMediaPosAt = 0;

    function updateMediaSession(forcePos = false) {
      if (!("mediaSession" in navigator)) return;
      try {
        const text = getDisplayTimeText();
        const phaseLabel = AppState.overtime ? "Overtime" : (AppState.isBreak() ? "Break" : "Focus");
        const intent = DOM.sessionIntentInput ? DOM.sessionIntentInput.value.trim() : "";
        const title = `${text} · ${phaseLabel}`;
        const artist = intent || "Pomodoro";
        const metaKey = `${title}|${artist}`;

        if (metaKey !== lastMediaMetaKey && typeof MediaMetadata !== "undefined") {
          lastMediaMetaKey = metaKey;
          navigator.mediaSession.metadata = new MediaMetadata({
            title,
            artist,
            album: "Pomodoro Ultimate"
          });
        }

        navigator.mediaSession.playbackState = AppState.running ? "playing" : "paused";

        const now = performance.now();
        if (typeof navigator.mediaSession.setPositionState === "function" && (forcePos || now - lastMediaPosAt >= 900)) {
          lastMediaPosAt = now;
          const duration = Math.max(1, AppState.sequence[AppState.idx] || 1);
          const position = Math.max(0, Math.min(duration, duration - AppState.remaining));
          navigator.mediaSession.setPositionState({
            duration,
            playbackRate: 1.0,
            position
          });
        }
      } catch (e) {}
    }

    if ("mediaSession" in navigator) {
      try {
        navigator.mediaSession.setActionHandler("play", () => {
          AudioEngine.getCtx();
          if (!AppState.running) {
            if (AppState.remaining <= 0) AppState.remaining = AppState.sequence[AppState.idx];
            toggle();
          }
        });
        navigator.mediaSession.setActionHandler("pause", () => {
          if (AppState.running) toggle();
        });
        navigator.mediaSession.setActionHandler("nexttrack", () => {
          advance(false);
        });
      } catch (e) {}
    }

    let wakeLockSentinel = null;
    async function syncWakeLock() {
      if (!("wakeLock" in navigator)) return;
      if (AppState.running && document.visibilityState === "visible") {
        if (!wakeLockSentinel) {
          try {
            wakeLockSentinel = await navigator.wakeLock.request("screen");
            wakeLockSentinel.addEventListener("release", () => { wakeLockSentinel = null; });
          } catch (e) {}
        }
      } else if (wakeLockSentinel) {
        try { await wakeLockSentinel.release(); } catch (e) {}
        wakeLockSentinel = null;
      }
    }
    document.addEventListener("visibilitychange", syncWakeLock);

    function sendDesktopNotification(title, body) {
      if (!isSwitchActive(DOM.notifToggle) || !("Notification" in window)) return;
      if (Notification.permission === "granted") {
        new Notification(title, { body });
      } else if (Notification.permission !== "denied") {
        Notification.requestPermission().then(permission => {
          if (permission === "granted") new Notification(title, { body });
        });
      }
    }

    function updateCycleIndicator() {
      if (!DOM.cycleIndicatorEl) return;
      const totalFocus = Math.max(1, Math.floor(AppState.sequence.length / 2));
      if (DOM.cycleIndicatorEl.children.length !== totalFocus) {
        DOM.cycleIndicatorEl.innerHTML = Array.from({ length: totalFocus }, () => '<span class="cycle-dot"></span>').join("");
      }
      const completedFocus = Math.ceil(AppState.idx / 2);
      Array.from(DOM.cycleIndicatorEl.children).forEach((dot, i) => {
        dot.classList.toggle("done", i < completedFocus);
      });
      DOM.cycleIndicatorEl.classList.toggle("visible", DOM.popup.classList.contains("visible"));
    }

    function getDisplayTimeText() {
      return AppState.overtime ? fmtOvertime(AppState.getOvertimeSec()) : fmt(AppState.remaining);
    }

    function syncTimeTrackingBaseline() {
      lastRenderedTimeText = getDisplayTimeText();
      lastRenderedTimerIndex = AppState.idx;
    }

    function flushOvertimeCredit() {
      if (!AppState.overtime) return;
      const totalOt = Math.floor(AppState.getOvertimeSec());
      const uncredited = Math.max(0, totalOt - AppState.overtimeCreditedSec);
      if (uncredited > 0) {
        StorageManager.recordOvertimeFocus(uncredited);
        AppState.overtimeCreditedSec = totalOt;
        StorageManager.savePrefs();
      }
      AppState.overtime = false;
      AppState.overtimeStartAt = 0;
      AppState.overtimeCreditedSec = 0;
    }

    function enterOvertime() {
      const today = new Date().toDateString();
      if (AppState.lastSavedDate !== today) {
        AppState.completedToday = 1;
        AppState.lastSavedDate = today;
      } else {
        AppState.completedToday++;
      }
      StorageManager.recordCompletedFocus(AppState.sequence[AppState.idx]);
      StorageManager.savePrefs();
      sendDesktopNotification("Pomodoro", "Focus session completed! Continuing in overtime.");
      AudioEngine.playSound("focusDone");

      AppState.overtime = true;
      AppState.overtimeStartAt = performance.now();
      AppState.overtimeCreditedSec = 0;
      AppState.remaining = 0;
      syncTimeTrackingBaseline();
      StorageManager.saveSessionState(true);
      render({ immediateFit: true });
    }

    function finishOvertimeToBreak() {
      AppState.afterBreak = false;
      if (!AppState.overtime) return;
      flushOvertimeCredit();
      AudioEngine.playSound("start");

      const nextIdx = (AppState.idx + 1) % AppState.sequence.length;
      AppState.afterBreak = !wasFocus && nextIdx === 0;
      const nextIsBreak = (nextIdx % 2) === 1;
      if (!(nextIsBreak && isSwitchActive(DOM.bgToggle) && BreakBackgroundManager.promotePreloadedIfAvailable())) {
        BreakBackgroundManager.clear(nextIsBreak);
      }

      AppState.idx = nextIdx;
      AppState.remaining = AppState.sequence[AppState.idx];
      AppState.running = true;
      AppState.stageStarted = true;
      AppState.endAt = performance.now() + AppState.remaining * 1000;
      syncTimeTrackingBaseline();
      StorageManager.saveSessionState(true);
      render({ immediateFit: true });
    }

    function render(opts = {}) {
      const { immediateFit = false } = opts;
      const text = getDisplayTimeText();

      lastRenderedTimeText = text;
      lastRenderedTimerIndex = AppState.idx;

      if (DOM.el.textContent !== text) {
        const lengthChanged = lastRenderedLength !== null && text.length !== lastRenderedLength;
        lastRenderedLength = text.length;
        DOM.el.textContent = text;
        if (lengthChanged && TypographyEngine.isReady()) {
          TypographyEngine.fit();
        }
      } else if (lastRenderedLength === null) {
        lastRenderedLength = text.length;
      }

      const nextTitle = text + (AppState.overtime ? " · overtime" : (AppState.isBreak() ? " · break" : " · focus"));
      if (document.title !== nextTitle) document.title = nextTitle;

      const total = AppState.sequence[AppState.idx] || 1;
      const progress = Math.min(100, Math.max(0, (1 - AppState.remaining / total) * 100));
      if (DOM.progressBar) {
        const showBar = isSwitchActive(DOM.progressToggle);
        DOM.progressBar.classList.toggle("hidden", !showBar);
        if (showBar) DOM.progressBar.style.width = progress.toFixed(1) + "%";
      }

      updateFavicon(progress);
      updateMediaSession(false);
      updateCycleIndicator();

      if (DOM.pomodoroCountEl) DOM.pomodoroCountEl.textContent = String(AppState.completedToday);
      if (DOM.weeklyFocusTotalEl) DOM.weeklyFocusTotalEl.textContent = StorageManager.getWeeklyFocusSummary();

      if (lastRunning !== AppState.running) {
        lastRunning = AppState.running;
        if (timerWorker) timerWorker.postMessage(AppState.running ? "start" : "stop");
        syncDisplayLoop();
        document.body.classList.toggle("running", AppState.running);
        if (immediateFit) TypographyEngine.fit();
        else              TypographyEngine.transitionToRunningState(AppState.running);
        syncWakeLock();
      } else if (immediateFit && TypographyEngine.isReady()) {
        TypographyEngine.fit();
      }

      AudioEngine.updateBrownNoise();
      AudioEngine.syncTickScheduler();
      BreakBackgroundManager.update();
    }

    function toggle() {
      AppState.afterBreak = false;
      AppState.running = !AppState.running;
      AppState.stageStarted = true;
      if (AppState.running) {
        AppState.endAt = performance.now() + AppState.remaining * 1000;
      }
      syncTimeTrackingBaseline();
      StorageManager.saveSessionState(true);
      AudioEngine.playSound(AppState.running ? "start" : "pause");
      render();
    }

    function advance(complete) {
      flushOvertimeCredit();
      const wasFocus = AppState.isFocus();

      if (complete) {
        if (wasFocus) {
          const today = new Date().toDateString();
          if (AppState.lastSavedDate !== today) {
            AppState.completedToday = 1;
            AppState.lastSavedDate = today;
          } else {
            AppState.completedToday++;
          }
          StorageManager.recordCompletedFocus(AppState.sequence[AppState.idx]);
          StorageManager.savePrefs();
          sendDesktopNotification("Pomodoro", "Focus session completed! Time for a break.");
        } else {
          sendDesktopNotification("Pomodoro", "Break finished! Back to focus.");
        }
        AudioEngine.playSound(wasFocus ? "focusDone" : "breakDone");
        AppState.running = isSwitchActive(DOM.autoStartToggle);
        AppState.stageStarted = AppState.running;
      } else {
        AudioEngine.playSound("skip");
        AppState.running = false;
        AppState.stageStarted = false;
        UIController.showIndicator(!wasFocus ? "Skipped to Focus ⏭" : "Skipped to Break ⏭");
      }

      const nextIdx = (AppState.idx + 1) % AppState.sequence.length;
      const nextIsBreak = (nextIdx % 2) === 1;

      if (!(nextIsBreak && isSwitchActive(DOM.bgToggle) && BreakBackgroundManager.promotePreloadedIfAvailable())) {
        BreakBackgroundManager.clear(nextIsBreak);
      }

      AppState.idx = nextIdx;
      AppState.remaining = AppState.sequence[AppState.idx];
      syncTimeTrackingBaseline();
      if (AppState.running) AppState.endAt = performance.now() + AppState.remaining * 1000;

      StorageManager.saveSessionState(true);
      render({ immediateFit: !AppState.running });
    }

    function reset() {
      AppState.afterBreak = false;
      flushOvertimeCredit();
      AppState.running = false;
      AppState.stageStarted = false;
      BreakBackgroundManager.clear(false);
      AppState.idx = 0;
      AppState.remaining = AppState.sequence[0];
      syncTimeTrackingBaseline();
      StorageManager.saveSessionState(true);
      AudioEngine.playSound("reset");
      UIController.showIndicator("Reset ↺");
      render({ immediateFit: true });
    }

    function tick() {
      if (!AppState.running) return;
      if (!AppState.overtime) {
        AppState.remaining = Math.max(0, (AppState.endAt - performance.now()) / 1000);
        if (AppState.remaining <= 0) {
          if (AppState.isFocus() && isSwitchActive(DOM.overtimeToggle)) {
            enterOvertime();
            return;
          }
          advance(true);
          return;
        }
      }
      const nextText = getDisplayTimeText();
      if (nextText !== lastRenderedTimeText || lastRenderedTimerIndex !== AppState.idx) {
        StorageManager.saveSessionState(false);
        render();
      } else if (AppState.isFocus() && (AppState.remaining <= 3.1 || (AppState.remaining <= 35 && AppState.remaining >= 34.5))) {
        AudioEngine.updateBrownNoise();
      AudioEngine.syncTickScheduler();
        BreakBackgroundManager.update();
      }
    }

    let displayRaf = null;
    function syncDisplayLoop() {
      if (AppState.running && document.visibilityState === "visible") {
        if (displayRaf === null) {
          const loop = () => {
            if (!AppState.running || document.visibilityState !== "visible") {
              displayRaf = null;
              return;
            }
            tick();
            displayRaf = requestAnimationFrame(loop);
          };
          displayRaf = requestAnimationFrame(loop);
        }
      } else if (displayRaf !== null) {
        cancelAnimationFrame(displayRaf);
        displayRaf = null;
      }
    }
    document.addEventListener("visibilitychange", () => {
      if (AppState.running) tick();
      syncDisplayLoop();
    });

    let timerWorker = null;
    try {
      const workerCode = `
        let timerId = null;
        self.onmessage = function(e) {
          if (e.data === "start") {
            if (timerId !== null) clearInterval(timerId);
            self.postMessage("tick");
            timerId = setInterval(() => self.postMessage("tick"), 100);
          } else if (e.data === "stop") {
            if (timerId !== null) {
              clearInterval(timerId);
              timerId = null;
            }
          }
        };
      `;
      const blob = new Blob([workerCode], { type: "application/javascript" });
      timerWorker = new Worker(URL.createObjectURL(blob));
      timerWorker.onmessage = () => tick();
    } catch (e) {
      setInterval(tick, 100);
    }

    function resetInternalTracking() {
      lastRunning = false;
      lastRenderedLength = null;
      syncTimeTrackingBaseline();
    }

    return {
      render,
      toggle,
      advance,
      reset,
      finishOvertimeToBreak,
      updateCycleIndicator,
      syncTimeTrackingBaseline,
      resetInternalTracking
    };
  })();

  /* =========================================================================
   * 7. INTERACTIONS & INTERFACE UTILISATEUR (UIController)
   * ========================================================================= */
  const UIController = (() => {
    let indicatorTimer = null;

    function showIndicator(text) {
      if (!DOM.volumeIndicator) return;
      DOM.volumeIndicator.textContent = text;
      DOM.volumeIndicator.classList.add("visible");
      clearTimeout(indicatorTimer);
      indicatorTimer = setTimeout(() => DOM.volumeIndicator.classList.remove("visible"), 800);
    }

    function syncIntentVisibility() {
      if (!DOM.sessionIntentDisplayEl || !DOM.sessionIntentInput) return;
      const text = DOM.sessionIntentInput.value.trim();
      const show = DOM.popup.classList.contains("visible") && Boolean(text);
      if (show) DOM.sessionIntentDisplayEl.textContent = text;
      DOM.sessionIntentDisplayEl.classList.toggle("visible", show);
    }

    const popupObserver = new MutationObserver(() => {
      BreakBackgroundManager.syncCaptionVisibility();
      TimerController.updateCycleIndicator();
      syncIntentVisibility();
    });
    popupObserver.observe(DOM.popup, { attributes: true, attributeFilter: ["class"] });

    const HOLD_PAUSE_MS  = 3000;
    const HOLD_RESUME_MS = 1000;
    let timerHoldRaf    = null;
    let timerHoldStart  = 0;
    let timerHoldDur    = 0;
    let activePointerId = null;
    let spaceHoldActive = false;

    function cancelTimerHold() {
      if (timerHoldRaf) {
        cancelAnimationFrame(timerHoldRaf);
        timerHoldRaf = null;
      }
      activePointerId = null;
      if (DOM.holdPrompt) DOM.holdPrompt.classList.remove("visible");
      if (DOM.holdPromptFill) DOM.holdPromptFill.style.width = "0%";
    }

    function startTimerHold() {
      cancelTimerHold();
      const targetPause = AppState.running;
      timerHoldDur = targetPause ? HOLD_PAUSE_MS : HOLD_RESUME_MS;
      timerHoldStart = performance.now();

      if (DOM.holdPromptText) {
        DOM.holdPromptText.textContent = targetPause ? "Hold to pause" : "Hold to resume";
      }
      if (DOM.holdPromptFill) DOM.holdPromptFill.style.width = "0%";
      if (DOM.holdPrompt) DOM.holdPrompt.classList.add("visible");

      function step(now) {
        const elapsed = now - timerHoldStart;
        const pct = Math.min(100, (elapsed / timerHoldDur) * 100);
        if (DOM.holdPromptFill) DOM.holdPromptFill.style.width = pct.toFixed(2) + "%";

        if (elapsed >= timerHoldDur) {
          timerHoldRaf = null;
          activePointerId = null;
          spaceHoldActive = false;
          if (DOM.holdPrompt) DOM.holdPrompt.classList.remove("visible");
          if (DOM.holdPromptFill) DOM.holdPromptFill.style.width = "0%";
          if (navigator.vibrate) navigator.vibrate(25);
          TimerController.toggle();
          return;
        }
        timerHoldRaf = requestAnimationFrame(step);
      }
      timerHoldRaf = requestAnimationFrame(step);
    }

    DOM.el.addEventListener("pointerdown", (e) => {
      if (e.button !== undefined && e.button !== 0) return;
      AudioEngine.getCtx();
      if (AppState.overtime) {
        TimerController.finishOvertimeToBreak();
        return;
      }
      if (!AppState.running && !AppState.stageStarted) {
        if (AppState.remaining <= 0) AppState.remaining = AppState.sequence[AppState.idx];
        TimerController.toggle();
        return;
      }
      startTimerHold();
      activePointerId = e.pointerId;
      if (DOM.el.setPointerCapture) {
        try { DOM.el.setPointerCapture(e.pointerId); } catch (err) {}
      }
    });

    ["pointerup", "pointercancel"].forEach(ev =>
      DOM.el.addEventListener(ev, (e) => {
        if (activePointerId !== null && e.pointerId === activePointerId) cancelTimerHold();
      })
    );

    window.addEventListener("blur", () => {
      spaceHoldActive = false;
      cancelTimerHold();
    });

    window.addEventListener("contextmenu", e => e.preventDefault());

    window.addEventListener("wheel", (e) => {
      if (e.target && e.target.tagName === "INPUT") return;
      if (DOM.popup && DOM.popup.classList.contains("visible") && DOM.popup.contains(e.target)) return;
      e.preventDefault();
      AudioEngine.getCtx();
      AudioEngine.setVolume(AudioEngine.getVolume() - e.deltaY * 0.001);
    }, { passive: false });

    if (DOM.volSlider) {
      DOM.volSlider.addEventListener("input", () => {
        AudioEngine.getCtx();
        AudioEngine.setVolumeSilent(parseInt(DOM.volSlider.value, 10) / 100);
        AudioEngine.showVolumeIndicator();
      });
      DOM.volSlider.addEventListener("change", StorageManager.scheduleSavePrefs);
    }

    let pillHideTimer = null;
    let hideTimer = null;

    const isTouchDevice = () =>
      (window.matchMedia && window.matchMedia("(hover: none), (pointer: coarse)").matches) ||
      ("ontouchstart" in window);

    function revealTopPill() {
      if (!DOM.topPill || DOM.popup.classList.contains("visible")) return;
      DOM.topPill.classList.add("visible");
      clearTimeout(pillHideTimer);
      if (isTouchDevice()) return;
      pillHideTimer = setTimeout(() => {
        if (!DOM.topPill.classList.contains("hovered")) {
          DOM.topPill.classList.remove("visible");
        }
      }, 1800);
    }

    function openPopup() {
      clearTimeout(hideTimer);
      clearTimeout(pillHideTimer);
      if (DOM.topPill) {
        DOM.topPill.classList.remove("visible", "hovered");
        DOM.topPill.classList.add("hidden-by-popup");
      }
      DOM.popup.classList.add("visible");
    }

    function closePopup() {
      DOM.popup.classList.remove("visible");
      if (DOM.topPill) {
        DOM.topPill.classList.remove("hidden-by-popup");
        revealTopPill();
      }
    }

    let sheetTouchStartY = 0;
    DOM.popup.addEventListener("touchstart", (e) => {
      if (e.touches && e.touches.length === 1) {
        sheetTouchStartY = e.touches[0].clientY;
      }
    }, { passive: true });
    DOM.popup.addEventListener("touchend", (e) => {
      if (!DOM.popup.classList.contains("visible") || !e.changedTouches || !e.changedTouches.length) return;
      const dy = e.changedTouches[0].clientY - sheetTouchStartY;
      if (DOM.popup.scrollTop <= 0 && dy > 64) {
        closePopup();
      }
    }, { passive: true });

    let ptrMoveScheduled = false;
    window.addEventListener("pointermove", () => {
      if (ptrMoveScheduled || DOM.popup.classList.contains("visible")) return;
      ptrMoveScheduled = true;
      requestAnimationFrame(() => {
        ptrMoveScheduled = false;
        revealTopPill();
      });
    }, { passive: true });

    window.addEventListener("touchstart", revealTopPill, { passive: true });

    DOM.hotZone.addEventListener("mouseenter", () => {
      if (DOM.topPill) DOM.topPill.classList.add("hovered");
      openPopup();
    });

    DOM.hotZone.addEventListener("click", (e) => {
      e.stopPropagation();
      openPopup();
    });

    DOM.popup.addEventListener("mouseleave", () => {
      if (DOM.factoryModalBackdrop && DOM.factoryModalBackdrop.classList.contains("visible")) return;
      hideTimer = setTimeout(closePopup, 180);
    });
    DOM.popup.addEventListener("mouseenter", () => clearTimeout(hideTimer));

    DOM.hotZone.addEventListener("mouseleave", (e) => {
      if (DOM.topPill) DOM.topPill.classList.remove("hovered");
      if (DOM.popup.contains(e.relatedTarget)) return;
      hideTimer = setTimeout(closePopup, 140);
    });

    window.addEventListener("pointerdown", (e) => {
      if (DOM.factoryModalBackdrop && DOM.factoryModalBackdrop.classList.contains("visible")) return;
      if (!DOM.popup.classList.contains("visible")) return;
      if (!DOM.popup.contains(e.target) && !DOM.hotZone.contains(e.target)) closePopup();
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && DOM.factoryModalBackdrop && DOM.factoryModalBackdrop.classList.contains("visible")) {
        e.preventDefault();
        closeFactoryModal();
        return;
      }
      if (e.key === "Escape" && DOM.popup.classList.contains("visible")) {
        e.preventDefault();
        closePopup();
        if (document.activeElement && DOM.popup.contains(document.activeElement)) {
          document.activeElement.blur();
        }
        return;
      }
      if (e.code === "Space" && !e.repeat && !e.metaKey && !e.ctrlKey && !e.altKey) {
        if (e.target && (["INPUT", "SELECT", "TEXTAREA", "BUTTON"].includes(e.target.tagName) || e.target.getAttribute("role") === "switch")) return;
        e.preventDefault();
        AudioEngine.getCtx();
        if (AppState.overtime) {
          TimerController.finishOvertimeToBreak();
          return;
        }
        if (!AppState.running && !AppState.stageStarted) {
          if (AppState.remaining <= 0) AppState.remaining = AppState.sequence[AppState.idx];
          TimerController.toggle();
          return;
        }
        spaceHoldActive = true;
        startTimerHold();
      }
    });

    window.addEventListener("keyup", (e) => {
      if (e.code === "Space" && spaceHoldActive) {
        e.preventDefault();
        spaceHoldActive = false;
        cancelTimerHold();
        return;
      }
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.target && ["INPUT", "SELECT", "TEXTAREA"].includes(e.target.tagName)) return;

      if (e.code === "KeyN" && DOM.noiseToggle) {
        e.preventDefault();
        AudioEngine.getCtx();
        setSwitchState(DOM.noiseToggle, !isSwitchActive(DOM.noiseToggle));
        AudioEngine.updateBrownNoise();
      AudioEngine.syncTickScheduler();
        StorageManager.savePrefs();
      } else if (e.code === "KeyM") {
        e.preventDefault();
        AudioEngine.toggleMute();
      } else if (e.code === "KeyF") {
        e.preventDefault();
        if (!document.fullscreenElement && !document.webkitFullscreenElement) {
          const docEl = document.documentElement;
          if (docEl.requestFullscreen) docEl.requestFullscreen().catch(() => {});
          else if (docEl.webkitRequestFullscreen) docEl.webkitRequestFullscreen();
        } else {
          if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
          else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        }
      }
    });

    // Switches accessibles au clic ET au clavier (Espace / Entrée)
    function bindSwitch(elSwitch, onToggle) {
      if (!elSwitch) return;
      const trigger = () => {
        const nextState = !isSwitchActive(elSwitch);
        setSwitchState(elSwitch, nextState);
        onToggle(nextState);
        StorageManager.savePrefs();
      };
      elSwitch.addEventListener("click", trigger);
      elSwitch.addEventListener("keydown", (e) => {
        if (e.code === "Space" || e.key === "Enter") {
          e.preventDefault();
          e.stopPropagation();
          trigger();
        }
      });
    }

    bindSwitch(DOM.noiseToggle, () => {
      AudioEngine.getCtx();
      AudioEngine.updateBrownNoise();
      AudioEngine.syncTickScheduler();
    });

    bindSwitch(DOM.progressToggle, () => {
      TimerController.render();
    });

    bindSwitch(DOM.tickToggle, (active) => {
      AudioEngine.getCtx();
      AudioEngine.syncTickScheduler();
      if (active && !AppState.running) AudioEngine.playWatchTick(true);
    });

    bindSwitch(DOM.notifToggle, (active) => {
      if (active && "Notification" in window && Notification.permission !== "granted") {
        Notification.requestPermission();
      }
    });

    bindSwitch(DOM.autoStartToggle, () => {});

    bindSwitch(DOM.overtimeToggle, (active) => {
      if (!active && AppState.overtime) {
        TimerController.finishOvertimeToBreak();
      } else {
        TimerController.render();
      }
    });

    bindSwitch(DOM.bgToggle, (active) => {
      if (!active) BreakBackgroundManager.clear(false);
      TimerController.render();
    });

    let lastValidBgSource = DOM.bgSourceSelect ? DOM.bgSourceSelect.value : "auto";
    if (lastValidBgSource === "custom") lastValidBgSource = "auto";

    async function syncCustomBgRow() {
      if (!DOM.bgCustomRow || !DOM.bgSourceSelect) return;
      const isCustom = DOM.bgSourceSelect.value === "custom";
      DOM.bgCustomRow.hidden = !isCustom;
      if (!isCustom) return;
      const meta = await BreakBackgroundManager.getCustomBgMeta();
      if (DOM.bgCustomName) {
        DOM.bgCustomName.textContent = meta ? meta.name : "No image selected";
      }
      if (DOM.bgCustomBtn) {
        DOM.bgCustomBtn.textContent = meta ? "Change…" : "Choose…";
      }
    }

    function openCustomImagePicker() {
      if (!DOM.bgCustomInput) return;
      DOM.bgCustomInput.value = "";
      DOM.bgCustomInput.click();
    }

    DOM.bgSourceSelect.addEventListener("change", async () => {
      const val = DOM.bgSourceSelect.value;
      if (val === "custom") {
        await syncCustomBgRow();
        const meta = await BreakBackgroundManager.getCustomBgMeta();
        if (!meta) {
          openCustomImagePicker();
          return;
        }
        lastValidBgSource = "custom";
        if (!BreakBackgroundManager.hotSwapSource()) {
          TimerController.render();
        }
        StorageManager.savePrefs();
        return;
      }
      lastValidBgSource = val;
      await syncCustomBgRow();
      if (!BreakBackgroundManager.hotSwapSource()) {
        TimerController.render();
      }
      StorageManager.savePrefs();
    });

    if (DOM.bgCustomBtn) {
      DOM.bgCustomBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        openCustomImagePicker();
      });
    }

    if (DOM.bgCustomInput) {
      DOM.bgCustomInput.addEventListener("cancel", async () => {
        const meta = await BreakBackgroundManager.getCustomBgMeta();
        if (!meta && DOM.bgSourceSelect.value === "custom") {
          DOM.bgSourceSelect.value = lastValidBgSource;
          await syncCustomBgRow();
        }
      });

      DOM.bgCustomInput.addEventListener("change", async () => {
        const file = DOM.bgCustomInput.files && DOM.bgCustomInput.files[0];
        if (!file) {
          const meta = await BreakBackgroundManager.getCustomBgMeta();
          if (!meta && DOM.bgSourceSelect.value === "custom") {
            DOM.bgSourceSelect.value = lastValidBgSource;
            await syncCustomBgRow();
          }
          return;
        }
        if (!file.type.startsWith("image/")) {
          showIndicator("Unsupported image format");
          return;
        }
        const ok = await BreakBackgroundManager.saveCustomBgFile(file);
        if (!ok) {
          showIndicator("Unable to save image");
          return;
        }
        DOM.bgSourceSelect.value = "custom";
        lastValidBgSource = "custom";
        await syncCustomBgRow();
        StorageManager.savePrefs();
        if (!BreakBackgroundManager.hotSwapSource()) {
          TimerController.render();
        }
        showIndicator("Custom image saved");
      });
    }

    function bindHoldButton(btn, fillEl, labelEl, idleText, holdingText, durationMs, onComplete) {
      if (!btn || !fillEl || !labelEl) return;
      let rafId = null;
      let startAt = 0;
      let pointerId = null;

      function cancelHold() {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        pointerId = null;
        fillEl.style.width = "0%";
        labelEl.textContent = idleText;
      }

      btn.addEventListener("pointerdown", (e) => {
        if (e.button !== undefined && e.button !== 0) return;
        e.stopPropagation();
        AudioEngine.getCtx();
        cancelHold();
        pointerId = e.pointerId;
        if (btn.setPointerCapture) {
          try { btn.setPointerCapture(e.pointerId); } catch (err) {}
        }
        startAt = performance.now();
        labelEl.textContent = holdingText;

        function step(now) {
          const elapsed = now - startAt;
          const pct = Math.min(100, (elapsed / durationMs) * 100);
          fillEl.style.width = pct.toFixed(2) + "%";
          if (elapsed >= durationMs) {
            rafId = null;
            pointerId = null;
            fillEl.style.width = "0%";
            labelEl.textContent = idleText;
            if (navigator.vibrate) navigator.vibrate(25);
            onComplete();
            return;
          }
          rafId = requestAnimationFrame(step);
        }
        rafId = requestAnimationFrame(step);
      });

      ["pointerup", "pointercancel"].forEach(ev =>
        btn.addEventListener(ev, (e) => {
          if (pointerId !== null && e.pointerId === pointerId) cancelHold();
        })
      );
      window.addEventListener("blur", cancelHold);
    }

    bindHoldButton(DOM.btnSkip, DOM.btnSkipFill, DOM.btnSkipLabel, "Skip", "Hold to skip…", 5000, () => {
      closePopup();
      TimerController.advance(false);
    });

    bindHoldButton(DOM.btnReset, DOM.btnResetFill, DOM.btnResetLabel, "Reset", "Hold to reset…", 5000, () => {
      closePopup();
      TimerController.reset();
    });

    function openFactoryModal() {
      clearTimeout(hideTimer);
      if (DOM.factoryModalBackdrop) DOM.factoryModalBackdrop.classList.add("visible");
    }

    function closeFactoryModal() {
      if (DOM.factoryModalBackdrop) DOM.factoryModalBackdrop.classList.remove("visible");
    }

    async function performFactoryReset() {
      closeFactoryModal();
      closePopup();

      try {
        localStorage.removeItem("pomodoro-prefs");
        localStorage.removeItem("pomodoro-session");
        localStorage.removeItem("pomodoro-seen-bgs");
        if (typeof window.name === "string" && window.name.startsWith("POMODORO_SESSION:")) {
          window.name = "";
        }
      } catch (e) {}

      if ("caches" in window) {
        try {
          const keys = await caches.keys();
          await Promise.all(keys.map(k => caches.delete(k)));
        } catch (e) {}
      }

      AppState.sequence = DEFAULT_SEQUENCE.map(m => m * 60);
      AppState.idx = 0;
      AppState.remaining = AppState.sequence[0];
      AppState.running = false;
      AppState.stageStarted = false;
      AppState.completedToday = 0;
      AppState.lastSavedDate = new Date().toDateString();
      AppState.dailyHistory = {};
      AppState.seenBgUrls = [];

      await BreakBackgroundManager.clearCustomBg();
      BreakBackgroundManager.resetPools();
      BreakBackgroundManager.clear(false);
      StorageManager.applyPrefsToUI(DEFAULT_PREFS);
      lastValidBgSource = DEFAULT_PREFS.bgSource;
      await syncCustomBgRow();
      syncIntentVisibility();

      TimerController.resetInternalTracking();
      AudioEngine.playSound("reset");
      showIndicator("All settings & data reset");
      TimerController.render({ immediateFit: true });
    }

    bindHoldButton(DOM.btnFactoryReset, DOM.btnFactoryResetFill, DOM.btnFactoryResetLabel, "Reset all", "Hold…", 6000, openFactoryModal);

    if (DOM.factoryCancelBtn) {
      DOM.factoryCancelBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        closeFactoryModal();
      });
    }
    if (DOM.factoryConfirmBtn) {
      DOM.factoryConfirmBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        performFactoryReset();
      });
    }
    if (DOM.factoryModalBackdrop) {
      DOM.factoryModalBackdrop.addEventListener("pointerdown", (e) => {
        e.stopPropagation();
        if (e.target === DOM.factoryModalBackdrop) closeFactoryModal();
      });
    }

    function syncPresetPills() {
      if (!DOM.presetPills) return;
      const f = String(parseInt(DOM.focusInput.value, 10) || 0);
      const b = String(parseInt(DOM.breakInput.value, 10) || 0);
      const l = String(parseInt(DOM.longBreakInput.value, 10) || 0);
      DOM.presetPills.forEach(pill => {
        const match = pill.dataset.focus === f && pill.dataset.break === b && pill.dataset.long === l;
        pill.classList.toggle("active", match);
      });
    }

    function applyDurationValues(shouldClosePopup = true) {
      const focusMin = Math.max(1, Math.min(480, parseInt(DOM.focusInput.value, 10) || DEFAULT_PREFS.focus));
      const breakMin = Math.max(1, Math.min(60,  parseInt(DOM.breakInput.value, 10) || DEFAULT_PREFS.break));
      const longBreakMin = Math.max(1, Math.min(120, parseInt(DOM.longBreakInput.value, 10) || DEFAULT_PREFS.longBreak));

      const oldTotal = AppState.sequence[AppState.idx] || 0;
      if (AppState.running && !AppState.overtime) {
        AppState.remaining = Math.max(0, (AppState.endAt - performance.now()) / 1000);
      }
      const elapsed = AppState.stageStarted ? Math.max(0, oldTotal - AppState.remaining) : 0;

      AppState.sequence = [
        focusMin * 60,
        breakMin * 60,
        focusMin * 60,
        breakMin * 60,
        focusMin * 60,
        longBreakMin * 60
      ];

      if (!AppState.overtime) {
        AppState.remaining = Math.max(0, AppState.sequence[AppState.idx] - elapsed);
      }
      BreakBackgroundManager.clear(AppState.isFocus());
      syncPresetPills();
      StorageManager.savePrefs();

      if (!AppState.overtime && AppState.remaining <= 0 && AppState.running) {
        if (shouldClosePopup) closePopup();
        TimerController.advance(true);
        return;
      }

      if (AppState.running && !AppState.overtime) {
        AppState.endAt = performance.now() + AppState.remaining * 1000;
      }
      TimerController.syncTimeTrackingBaseline();
      StorageManager.saveSessionState(true);
      TimerController.render({ immediateFit: !AppState.running });
      if (shouldClosePopup) closePopup();
    }

    if (DOM.presetPills) {
      DOM.presetPills.forEach(pill => {
        pill.addEventListener("click", (e) => {
          e.stopPropagation();
          DOM.focusInput.value = pill.dataset.focus;
          DOM.breakInput.value = pill.dataset.break;
          DOM.longBreakInput.value = pill.dataset.long;
          applyDurationValues(false);
        });
      });
    }

    [DOM.focusInput, DOM.breakInput, DOM.longBreakInput].forEach(input => {
      input.addEventListener("input", () => {
        syncPresetPills();
        StorageManager.scheduleSavePrefs();
      });
    });

    if (DOM.sessionIntentInput) {
      DOM.sessionIntentInput.addEventListener("input", () => {
        syncIntentVisibility();
        StorageManager.scheduleSavePrefs();
      });
      DOM.sessionIntentInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          DOM.sessionIntentInput.blur();
        }
      });
    }

    DOM.applyBtn.addEventListener("click", () => applyDurationValues(true));

    return {
      showIndicator,
      isTouchDevice,
      syncPresetPills,
      syncIntentVisibility,
      syncCustomBgRow
    };
  })();

  /* =========================================================================
   * 8. INITIALISATION & PIPELINE DE RÉVÉLATION
   * ========================================================================= */
  StorageManager.loadAll();
  UIController.syncPresetPills();
  UIController.syncCustomBgRow();
  window.addEventListener("storage", StorageManager.syncFromStorageEvent);
  document.addEventListener("fullscreenchange", () => {
    if (TypographyEngine.isReady()) TypographyEngine.fit(true);
  });

  const unlockAudioOnGesture = () => {
    AudioEngine.getCtx();
    window.removeEventListener("pointerdown", unlockAudioOnGesture, true);
    window.removeEventListener("keydown", unlockAudioOnGesture, true);
  };
  window.addEventListener("pointerdown", unlockAudioOnGesture, { capture: true, passive: true });
  window.addEventListener("keydown", unlockAudioOnGesture, { capture: true, passive: true });

  if (UIController.isTouchDevice() && DOM.topPill) DOM.topPill.classList.add("visible");
  TypographyEngine.applyVariation();
  TimerController.render({ immediateFit: true });

  let rzRaf = null;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(rzRaf);
    rzRaf = requestAnimationFrame(() => TypographyEngine.fit());
  });

  if (typeof ResizeObserver !== "undefined") {
    let innerRefit = false;
    const ro = new ResizeObserver(() => {
      if (innerRefit || !TypographyEngine.isReady()) return;
      innerRefit = true;
      TypographyEngine.fit(true);
      requestAnimationFrame(() => { innerRefit = false; });
    });
    ro.observe(document.documentElement);
  }
  if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", () => {
      if (TypographyEngine.isReady()) TypographyEngine.fit(true);
    }, { passive: true });
  }
  window.addEventListener("orientationchange", () => {
    setTimeout(() => {
      if (TypographyEngine.isReady()) TypographyEngine.fit(true);
    }, 120);
  });
  window.addEventListener("pageshow", () => {
    if (TypographyEngine.isReady()) TypographyEngine.fit(true);
  });
  setTimeout(() => {
    if (TypographyEngine.isReady()) TypographyEngine.fit(true);
  }, 150);

  let revealed = false;
  let revealAttempts = 0;

  function revealTimer() {
    if (revealed) return;
    const ok = TypographyEngine.fit();
    if (!ok && revealAttempts < 60) {
      revealAttempts++;
      requestAnimationFrame(revealTimer);
      return;
    }
    revealed = true;
    void DOM.el.offsetWidth;
    requestAnimationFrame(() => {
      document.body.classList.add("ready");
    });
  }

  TypographyEngine.getMeasureEl();
  const fontLoads = (document.fonts && document.fonts.load)
    ? Promise.allSettled([
        document.fonts.load('100 100px "Google Sans Flex"', "0123456789:-"),
        document.fonts.load('300 100px "Google Sans Flex"', "0123456789:-")
      ])
    : Promise.resolve();

  Promise.race([
    fontLoads,
    new Promise(resolve => setTimeout(resolve, 800))
  ]).then(revealTimer);
  setTimeout(revealTimer, 1200);

  if (document.fonts) {
    if (document.fonts.ready) document.fonts.ready.then(TypographyEngine.clearCacheAndRefit);
    if (document.fonts.addEventListener) {
      document.fonts.addEventListener("loadingdone", TypographyEngine.clearCacheAndRefit);
    }
  }

  /* ---------- Fenêtre d'information & Crédits (Hugo Maurin) ---------- */
  (() => {
    const btnInfo = document.getElementById("btn-info");
    const infoBackdrop = document.getElementById("info-modal-backdrop");
    const infoCloseBtn = document.getElementById("info-close-btn");
    const popupEl = document.getElementById("popup");
    if (!btnInfo || !infoBackdrop) return;

    const openInfoModal = () => infoBackdrop.classList.add("visible");
    const closeInfoModal = () => infoBackdrop.classList.remove("visible");

    btnInfo.addEventListener("click", (e) => {
      e.stopPropagation();
      openInfoModal();
    });

    if (infoCloseBtn) {
      infoCloseBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        closeInfoModal();
      });
    }

    if (popupEl) {
      popupEl.addEventListener("mouseleave", (e) => {
        if (infoBackdrop.classList.contains("visible")) {
          e.stopImmediatePropagation();
        }
      }, true);
    }

    window.addEventListener("pointerdown", (e) => {
      if (!infoBackdrop.classList.contains("visible")) return;
      if (e.target === infoBackdrop) {
        closeInfoModal();
      }
      e.stopImmediatePropagation();
    }, true);

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && infoBackdrop.classList.contains("visible")) {
        e.preventDefault();
        e.stopImmediatePropagation();
        closeInfoModal();
      }
    }, true);
  })();
})();
</script>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    const isLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
    if (isLocal) {
      navigator.serviceWorker.getRegistrations().then(regs => {
        regs.forEach(r => r.unregister());
      }).catch(() => {});
      return;
    }
    navigator.serviceWorker.register('sw.js', { updateViaCache: 'none' }).then(reg => reg.update()).catch(() => {});
  });
}
</script>
</body>
</html>
